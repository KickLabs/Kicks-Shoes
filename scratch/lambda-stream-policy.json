{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream",
        "dynamodb:ListStreams"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:318662970982:table/kicks-shoes-chat-messages/stream/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:318662970982:table/kicks-shoes-chat-messages",
        "arn:aws:dynamodb:us-east-1:318662970982:table/kicks-shoes-chat-messages/index/*"
      ]
    }
  ]
}
