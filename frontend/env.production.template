# WebRTC Configuration for Cross-Network Connectivity
# Copy this file to .env and fill in your TURN server details

# API Configuration
VITE_API_BASE_URL=https://kicks-shoes-backend.azurewebsites.net/api
VITE_SOCKET_URL=https://kicks-shoes-backend.azurewebsites.net

# TURN Server Configuration (Recommended for production)
# Get TURN credentials from:
# - Xirsys: https://xirsys.com (free tier available)
# - Twilio: https://www.twilio.com/docs/stun-turn
# - Or self-host with coturn

# TURN Server URLs (comma-separated for multiple servers)
VITE_TURN_URL=turn:your-turn-server.com:3478?transport=udp,turn:your-turn-server.com:3478?transport=tcp,turns:your-turn-server.com:5349?transport=tcp

# TURN Server Credentials
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_password

# WebRTC Debugging (set to 1 to force TURN-only for testing)
# This helps diagnose cross-network issues
VITE_WEBRTC_FORCE_TURN=0

# Example configurations:

# For Xirsys (free tier):
# VITE_TURN_URL=turn:global.xirsys.com:80?transport=udp,turn:global.xirsys.com:80?transport=tcp
# VITE_TURN_USERNAME=your_xirsys_username
# VITE_TURN_CREDENTIAL=your_xirsys_token

# For Twilio:
# VITE_TURN_URL=turn:global.turn.twilio.com:3478?transport=udp,turn:global.turn.twilio.com:3478?transport=tcp,turns:global.turn.twilio.com:5349?transport=tcp
# VITE_TURN_USERNAME=your_twilio_username
# VITE_TURN_CREDENTIAL=your_twilio_credential

# For self-hosted coturn:
# VITE_TURN_URL=turn:your-domain.com:3478?transport=udp,turn:your-domain.com:3478?transport=tcp
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_password