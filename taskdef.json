{
  "family": "ddb-cache-lab-product-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {"operatingSystemFamily": "LINUX", "cpuArchitecture": "ARM64"},
  "executionRoleArn": "arn:aws:iam::159615636680:role/ddb-cache-lab-task-exec",
  "taskRoleArn": "arn:aws:iam::159615636680:role/ddb-cache-lab-task-role",
  "containerDefinitions": [{
    "name": "product-api",
    "image": "159615636680.dkr.ecr.ap-southeast-1.amazonaws.com/ddb-cache-lab/product-api:v1.0.1",
    "essential": true,
    "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
    "environment": [
      {"name": "TABLE_NAME", "value": "ddb-cache-lab-products"},
      {"name": "REDIS_HOST", "value": "master.kicks-shoes-redis.w8hgpb.apse1.cache.amazonaws.com"},
      {"name": "AWS_REGION", "value": "ap-southeast-1"},
      {"name": "CACHE_TTL_SECONDS", "value": "300"}
    ],
    "secrets": [
      {"name": "REDIS_AUTH_TOKEN", "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:159615636680:secret:ddb-cache-lab/redis/auth-token-GuAyc1:authToken::"}
    ],
    "healthCheck": {
      "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz').read()\" || exit 1"],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 15
    },
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/ddb-cache-lab/product-api",
        "awslogs-region": "ap-southeast-1",
        "awslogs-stream-prefix": "ecs"
      }
    },
    "readonlyRootFilesystem": false,
    "ulimits": [{"name": "nofile", "softLimit": 65536, "hardLimit": 65536}]
  }]
}
