  test('TC-93 | Test updateOrderStatus method - success case', async () => {
    // Given - save an order first with valid ObjectIds
    const mongoose = await import('mongoose');
    const streamId = new mongoose.Types.ObjectId();
    const userId = new mongoose.Types.ObjectId();
    const hostId = new mongoose.Types.ObjectId(); // Valid host ObjectId

    const messageData = makeMessage('Mua size 42 0912345678'); // Simple message
    const streamData = makeStream({ _id: streamId });
    const userData = makeUser({ _id: userId });

    const analysisResult = await orderDetectionService.analyzeMessage(
      messageData,
      streamData,
      userData
    );
    const savedOrder = await orderDetectionService.savePotentialOrder(analysisResult);

    // When - update status with valid ObjectId
    const updatedOrder = await orderDetectionService.updateOrderStatus(
      savedOrder._id.toString(),
      'confirmed',
      hostId.toString(),
      'Order confirmed by host'
    );

    // Then - verify update
    expect(updatedOrder).toBeDefined();
    expect(updatedOrder.status).toBe('confirmed');
    expect(updatedOrder.hostActions.confirmedBy.toString()).toBe(hostId.toString());
    expect(updatedOrder.hostActions.confirmedAt).toBeInstanceOf(Date);
  });

