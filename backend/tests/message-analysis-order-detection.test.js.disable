import { jest } from '@jest/globals';
import mongoose from 'mongoose';
import orderDetectionService from '../src/services/orderDetection.service.js';
import { makeMessage, makeStream, makeUser } from './_helpers/testUtils.js';

// Mock logger to reduce noise in test output
jest.mock(
  '../src/utils/logger.js',
  () => ({
    default: {
      info: jest.fn(),
      error: jest.fn(),
      warn: jest.fn(),
    },
  }),
  { virtual: true }
);

describe('Order in Livestream — Message Analysis & Order Detection', () => {
  beforeAll(async () => {
    const mongoUri = process.env.MONGODB_URI || 'mongodb://localhost:27017/kicks-shoes';

    if (mongoose.connection.readyState === 0) {
      await mongoose.connect(mongoUri, {
        serverSelectionTimeoutMS: 5000,
      });
      console.log('✅ Connected to MongoDB for testing');
    }
  }, 10000);

  afterAll(async () => {
    if (mongoose.connection.readyState !== 0) {
      await mongoose.connection.close();
      console.log('✅ Closed MongoDB connection');
    }
  });

  beforeEach(() => {
    jest.clearAllMocks();
  });

  test('TC-01 | Basic order detection with phone and keywords', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn size 42 sđt 0912345678');
    const streamData = makeStream({ roomId: 'test-room-123' });
    const userData = makeUser({ _id: 'user123', username: 'buyer01' });

    // When
    const result = await orderDetectionService.analyzeMessage(messageData, streamData, userData);

    // Then
    expect(result.isOrder).toBe(true);
    expect(result.confidence).toBeGreaterThanOrEqual(0.3);
    expect(result.data.customerInfo.phoneNumber).toBe('0912345678');
    expect(result.data.productInfo.extractedSize).toBe('42');
    expect(result.data.detectionData.detectedKeywords).toContain('chốt');
    expect(result.data.detectionData.detectedKeywords).toContain('đơn');
    expect(result.data.detectionData.detectedKeywords).toContain('size');
  });

  test('TC-02 | Phone number validation and edge cases', async () => {
    // Given
    const validPhones = ['0312345678', '0512345678', '0712345678', '0812345678', '0912345678'];
    const invalidPhone = '0212345678';

    // When & Then
    for (const phone of validPhones) {
      const messageData = makeMessage(`Mua ${phone}`);
      const result = await orderDetectionService.analyzeMessage(
        messageData,
        makeStream(),
        makeUser()
      );
      expect(result.data.customerInfo.phoneNumber).toBe(phone);
    }

    const invalidMessageData = makeMessage(`Chốt ${invalidPhone} size 42`);
    const invalidResult = await orderDetectionService.analyzeMessage(
      invalidMessageData,
      makeStream(),
      makeUser()
    );
    expect(invalidResult).toBeNull();
  });

  test('TC-03 | Confidence calculation and threshold behavior', async () => {
    // Given
    const highConfMessage = makeMessage('Chốt đơn ship gấp COD 0912345678 size 42');
    const lowConfMessage = makeMessage('ok 0912345678'); // Lower confidence message

    // When
    const highResult = await orderDetectionService.analyzeMessage(
      highConfMessage,
      makeStream(),
      makeUser()
    );
    const lowResult = await orderDetectionService.analyzeMessage(
      lowConfMessage,
      makeStream(),
      makeUser()
    );

    // Then
    expect(highResult.confidence).toBeGreaterThanOrEqual(0.7);
    // Lower confidence message should have lower confidence
    if (lowResult) {
      expect(lowResult.confidence).toBeLessThan(highResult.confidence);
    }
  });

  test('TC-04 | Product type handling and SKU matching', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn size 42 0912345678');

    // When
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then - verify order detection works
    expect(result.isOrder).toBe(true);
    expect(result.data.customerInfo.phoneNumber).toBe('0912345678');
    expect(result.data.productInfo.extractedSize).toBe('42');
  });

  test('TC-05 | Comprehensive pattern matching', async () => {
    // Given
    const testCases = [
      { msg: 'Chốt đơn 0912345678 size 42', expectedSize: '42' },
      { msg: 'Chốt đơn 0912345678 cỡ XL', expectedSize: 'XL' },
      { msg: 'Chốt đơn 0912345678 màu đỏ size 42', expectedColor: 'đỏ', expectedSize: '42' },
      {
        msg: 'chốt 2 đôi size 42 màu đỏ 0912345678',
        expectedQuantity: 2,
        expectedColor: 'đỏ',
        expectedSize: '42',
      },
    ];

    // When & Then
    for (const { msg, expectedSize, expectedColor, expectedQuantity } of testCases) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      if (expectedSize) expect(result.data.productInfo.extractedSize).toBe(expectedSize);
      if (expectedColor) expect(result.data.productInfo.extractedColor).toBe(expectedColor);
      if (expectedQuantity) expect(result.data.productInfo.quantity).toBe(expectedQuantity);
    }
  });

  test('TC-06 | Keyword detection and phone extraction', async () => {
    // Given
    const testCases = [
      {
        msg: 'Chốt đơn 0912345678 hoặc 0987654321 size 42',
        phones: ['0912345678', '0987654321'],
        keywords: ['chốt', 'đơn', 'size'],
      },
      { msg: 'Mua ngay ship gấp 0912345678 size 42', keywords: ['mua', 'ship', 'size'] },
      {
        msg: 'Đặt hàng chốt đơn 0912345678 size 42',
        keywords: ['đặt', 'đặt hàng', 'chốt', 'đơn', 'size'],
      },
    ];

    // When & Then
    for (const { msg, phones, keywords } of testCases) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.data.customerInfo.phoneNumbers).toEqual(
        phones || [result.data.customerInfo.phoneNumber]
      );
      // Check that all expected keywords are present
      keywords.forEach(keyword => {
        expect(result.data.detectionData.detectedKeywords).toContain(keyword);
      });
    }
  });

  test('TC-07 | Error handling and edge cases', async () => {
    // Given - Test empty or invalid messages
    const emptyMessage = makeMessage('');
    const noKeywordMessage = makeMessage('hello 0912345678');

    // When
    const emptyResult = await orderDetectionService.analyzeMessage(
      emptyMessage,
      makeStream(),
      makeUser()
    );
    const noKeywordResult = await orderDetectionService.analyzeMessage(
      noKeywordMessage,
      makeStream(),
      makeUser()
    );

    // Then - should return null for invalid messages
    expect(emptyResult).toBeNull();
    expect(noKeywordResult).toBeNull();
  });

  test('TC-08 | Security testing (SQL injection, XSS)', async () => {
    // Given
    const sqlPayloads = [
      "'; DROP TABLE users-- 0912345678",
      "1' OR '1'='1 0912345678",
      "'; INSERT INTO users VALUES ('hacker')-- 0912345678",
    ];
    const xssPayload = "Chốt đơn <script>alert('xss')</script> 0912345678 size 42";

    // When & Then
    for (const payload of sqlPayloads) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(payload),
        makeStream(),
        makeUser()
      );
      expect(result).toBeNull();
    }

    const xssResult = await orderDetectionService.analyzeMessage(
      makeMessage(xssPayload),
      makeStream(),
      makeUser()
    );
    expect(xssResult.data.detectionData.detectedKeywords).toContain('chốt');
    expect(xssResult.data.customerInfo.phoneNumber).toBe('0912345678');
  });

  test('TC-09 | Performance and timeout testing', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn 0912345678 size 42');

    // When
    const start = Date.now();
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );
    const duration = Date.now() - start;

    // Then
    expect(result.isOrder).toBe(true);
    expect(duration).toBeLessThan(100);
  });

  test('TC-10 | Confidence capping and boundary testing', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn ship gấp COD mua ngay đặt hàng 0912345678 size 42');

    // When - use message with many keywords to naturally boost confidence
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then - confidence should be capped at 1.0
    expect(result.confidence).toBeLessThanOrEqual(1.0);
    expect(result.confidence).toBeGreaterThan(0.5);
  });

  test('TC-11 | Multiple phone numbers handling', async () => {
    // Given
    const messageData = makeMessage('Chốt 0912345678 hoặc 0987654321 size 42');

    // When
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then
    expect(result.data.customerInfo.phoneNumbers).toEqual(['0912345678', '0987654321']);
    expect(result.data.customerInfo.phoneNumber).toBe('0912345678');
    expect(result.isOrder).toBe(true);
  });

  test('TC-12 | Short message penalty and edge cases', async () => {
    // Given
    const shortMessage = makeMessage('Mua 0912345678');
    const noPhoneMessage = makeMessage('Chốt đơn size 42');

    // When
    const shortResult = await orderDetectionService.analyzeMessage(
      shortMessage,
      makeStream(),
      makeUser()
    );
    const noPhoneResult = await orderDetectionService.analyzeMessage(
      noPhoneMessage,
      makeStream(),
      makeUser()
    );

    // Then
    // Short message may have low confidence or be null
    if (shortResult) {
      expect(shortResult.confidence).toBeLessThan(0.5);
    }
    // No phone number should always return null
    expect(noPhoneResult).toBeNull();
  });

  test('TC-13 | Composite pattern parsing with complex scenarios', async () => {
    // Given
    const messageData = makeMessage('chốt 2 đôi màu đỏ size 42 0912345678');

    // When
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then
    expect(result.data.productInfo.quantity).toBe(2);
    expect(result.data.productInfo.extractedColor).toBe('đỏ');
    expect(result.data.productInfo.extractedSize).toBe('42');
  });

  test('TC-14 | Advanced keyword combinations and confidence boosting', async () => {
    // Given
    const testCases = [
      { msg: 'Mua đặt hàng chốt đơn 0912345678 size 40', expectedConf: 0.3 },
      { msg: 'Chốt COD 0912345678 size 42', expectedConf: 0.3 },
    ];

    // When & Then
    for (const { msg, expectedConf } of testCases) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.confidence).toBeGreaterThanOrEqual(expectedConf);
    }
  });

  test('TC-15 | Comprehensive integration test covering all major paths', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn ship gấp COD 0912345678 size 42 màu đỏ');

    // When
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then
    expect(result.isOrder).toBe(true);
    expect(result.confidence).toBeGreaterThanOrEqual(0.7);
    expect(result.data.customerInfo.phoneNumber).toBe('0912345678');
    expect(result.data.productInfo.extractedSize).toBe('42');
    expect(result.data.productInfo.extractedColor).toBe('đỏ');
    expect(result.data.detectionData.detectedKeywords).toContain('chốt');
    expect(result.data.detectionData.detectedKeywords).toContain('ship');
    expect(result.data.detectionData.detectedKeywords).toContain('size');
  });

  test('TC-16 | Additional coverage for edge cases and error paths', async () => {
    // Given
    const phoneFormats = ['0912345678', '0312345678', '0512345678', '0712345678', '0812345678'];

    // When & Then - Test với data thực từ MongoDB
    for (const phone of phoneFormats) {
      const msg = makeMessage(`Chốt đơn ${phone} size 42`);
      const result = await orderDetectionService.analyzeMessage(msg, makeStream(), makeUser());
      expect(result.data.customerInfo.phoneNumber).toBe(phone);
      // productId có thể null hoặc có giá trị tùy vào SKU trong DB
    }
  });

  test('TC-17 | Confidence calculation edge cases and boundary conditions', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn 0912345678 size 42');

    // When
    const result = await orderDetectionService.analyzeMessage(
      messageData,
      makeStream(),
      makeUser()
    );

    // Then
    expect(result.confidence).toBeGreaterThan(0.3);
  });

  test('TC-18 | Various keyword combinations for maximum coverage', async () => {
    // Given
    const keywords = ['Chốt đơn', 'Mua ngay', 'Đặt hàng', 'Ship gấp', 'COD'];

    // When & Then
    for (const keyword of keywords) {
      const msg = `${keyword} 0912345678 size 42`;
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
    }
  });

  test('TC-19 | Size and color extraction edge cases', async () => {
    // Given
    const testCases = [
      { msg: 'Chốt đơn 0912345678 size 42 màu đỏ', size: '42', color: 'đỏ' },
      { msg: 'Chốt đơn 0912345678 cỡ XL màu xanh', size: 'XL', color: 'xanh' },
      { msg: 'Chốt đơn 0912345678 size ONE SIZE', size: 'ONESIZE' },
      { msg: 'Chốt đơn 0912345678 màu vàng size 40', size: '40', color: 'vàng' },
    ];

    // When & Then
    for (const { msg, size, color } of testCases) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.data.productInfo.extractedSize).toBe(size);
      if (color) expect(result.data.productInfo.extractedColor).toBe(color);
    }
  });

  test('TC-20 | Error handling and recovery scenarios', async () => {
    // Given
    const emptyMessage = makeMessage('');
    const numbersOnly = makeMessage('0912345678');
    const shortMessage = makeMessage('Hi');

    // When
    const emptyResult = await orderDetectionService.analyzeMessage(
      emptyMessage,
      makeStream(),
      makeUser()
    );
    const numbersResult = await orderDetectionService.analyzeMessage(
      numbersOnly,
      makeStream(),
      makeUser()
    );
    const shortResult = await orderDetectionService.analyzeMessage(
      shortMessage,
      makeStream(),
      makeUser()
    );

    // Then
    expect(emptyResult).toBeNull();
    expect(numbersResult).toBeNull();
    expect(shortResult).toBeNull();
  });

  test('TC-21 | Additional coverage for uncovered lines and edge cases', async () => {
    // Given
    const colors = ['đỏ', 'xanh', 'vàng', 'đen', 'trắng'];

    // When & Then
    for (const color of colors) {
      const msg = `Chốt đơn 0912345678 size 42 màu ${color}`;
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
    }
  });

  test('TC-22 | More edge cases for maximum coverage', async () => {
    // Given
    const phonePrefixes = ['03', '05', '07', '08', '09'];

    // When & Then
    for (const prefix of phonePrefixes) {
      const phone = `${prefix}12345678`;
      const msg = `Chốt đơn ${phone} size 42`;
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.data.customerInfo.phoneNumber).toBe(phone);
    }
  });

  test('TC-23 | Confidence calculation with different scenarios', async () => {
    // Given
    const scenarios = [
      'Chốt đơn 0912345678 size 42',
      'Mua ngay 0912345678 size 42',
      'Đặt hàng 0912345678 size 42',
      'Ship gấp 0912345678 size 42',
      'COD 0912345678 size 42',
    ];

    // When & Then
    for (const scenario of scenarios) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(scenario),
        makeStream(),
        makeUser()
      );
      expect(result.confidence).toBeGreaterThanOrEqual(0.3);
    }
  });

  test('TC-24 | More comprehensive scenarios for maximum coverage', async () => {
    // Given
    const combinations = [
      { msg: 'Chốt đơn 0912345678 size 42 màu đỏ', color: 'đỏ' },
      { msg: 'Mua ngay 0912345678 size 42 màu xanh', color: 'xanh' },
      { msg: 'Đặt hàng 0912345678 size 42 màu vàng', color: 'vàng' },
      { msg: 'Ship gấp 0912345678 size 42 màu đen', color: 'đen' },
      { msg: 'COD 0912345678 size 42 màu trắng', color: 'trắng' },
      { msg: 'Chốt COD ship gấp 0912345678 size 42 màu đỏ', color: 'đỏ' },
    ];

    // When & Then
    for (const { msg, color } of combinations) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
      expect(result.confidence).toBeGreaterThanOrEqual(0.3);
      expect(result.data.productInfo.extractedColor).toBe(color);
    }
  });

  test('TC-25 | Final edge cases for maximum coverage', async () => {
    // Given
    const finalTests = [
      'Chốt đơn 0912345678 size 42',
      'Mua ngay 0912345678 size 42',
      'Đặt hàng 0912345678 size 42',
      'Ship gấp 0912345678 size 42',
      'COD 0912345678 size 42',
      'Chốt COD ship gấp 0912345678 size 42',
    ];

    // When & Then
    for (const test of finalTests) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(test),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
    }
  });

  test('TC-26 | Additional coverage tests for uncovered lines', async () => {
    // Given
    const additionalTests = [
      { msg: 'Chốt đơn 0912345678 size 42 màu đỏ', color: 'đỏ' },
      { msg: 'Mua ngay 0912345678 size 42 màu xanh', color: 'xanh' },
      { msg: 'Đặt hàng 0912345678 size 42 màu vàng', color: 'vàng' },
      { msg: 'Ship gấp 0912345678 size 42 màu đen', color: 'đen' },
      { msg: 'COD 0912345678 size 42 màu trắng', color: 'trắng' },
      { msg: 'Chốt COD ship gấp 0912345678 size 42 màu đỏ', color: 'đỏ' },
    ];

    // When & Then
    for (const { msg, color } of additionalTests) {
      const result = await orderDetectionService.analyzeMessage(
        makeMessage(msg),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
      expect(result.confidence).toBeGreaterThanOrEqual(0.3);
      expect(result.data.productInfo.extractedColor).toBe(color);
    }
  });

  test('TC-27 | Test more edge cases for maximum coverage', async () => {
    // Given
    const edgeTests = [
      'Chốt đơn 0912345678 size 42',
      'Mua ngay 0912345678 size 42',
      'Đặt hàng 0912345678 size 42',
      'Ship gấp 0912345678 size 42',
      'COD 0912345678 size 42',
      'Chốt COD ship gấp 0912345678 size 42',
