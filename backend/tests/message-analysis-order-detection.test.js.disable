      const result = await orderDetectionService.analyzeMessage(
        makeMessage(test),
        makeStream(),
        makeUser()
      );
      expect(result.isOrder).toBe(true);
    }
  });

  test('TC-28 | Test comprehensive scenarios for maximum coverage', async () => {
    // Given
    const comprehensiveTests = [
      { msg: 'Chốt đơn 0912345678 size 42 màu đỏ', color: 'đỏ' },
      { msg: 'Mua ngay 0912345678 size 42 màu xanh', color: 'xanh' },
      { msg: 'Đặt hàng 0912345678 size 42 màu vàng', color: 'vàng' },
      { msg: 'Ship gấp 0912345678 size 42 màu đen', color: 'đen' },
      { msg: 'COD 0912345678 size 42 màu trắng', color: 'trắng' },
      { msg: 'Chốt COD ship gấp 0912345678 size 42 màu đỏ', color: 'đỏ' },
    ];

    // When & Then
