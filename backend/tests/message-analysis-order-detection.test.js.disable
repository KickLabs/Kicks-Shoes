  test('TC-34 | Test getPendingOrdersForStream method', async () => {
    // Given - Test that service has the method
    expect(orderDetectionService.getPendingOrdersForStream).toBeDefined();
    expect(typeof orderDetectionService.getPendingOrdersForStream).toBe('function');
