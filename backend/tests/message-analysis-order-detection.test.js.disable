  test('TC-130 | Test all shipping keywords', async () => {
    // Given - test both ship and giao keywords (+0.1 boost)
    const confShip = orderDetectionService.calculateConfidence(
      'mua ship 0912345678',
      ['0912345678'],
      ['mua', 'ship']
    );
    const confGiao = orderDetectionService.calculateConfidence(
      'mua giao 0912345678',
      ['0912345678'],
      ['mua', 'giao']
    );

    // Then - both should get boost
    expect(confShip).toBeGreaterThan(0.4);
    expect(confGiao).toBeGreaterThan(0.4);
  });
});
