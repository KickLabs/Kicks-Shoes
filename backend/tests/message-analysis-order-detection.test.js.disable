      );
      expect(result.isOrder).toBe(true);
      expect(result.confidence).toBeGreaterThanOrEqual(0.3);
      expect(result.data.productInfo.extractedColor).toBe(color);
    }
  });

  test('TC-29 | Test clothing product type handling', async () => {
    // Given
    const messageData = makeMessage('Chốt đơn áo thun size XL 0912345678');

    // When
    const result = await orderDetectionService.analyzeMessage(
