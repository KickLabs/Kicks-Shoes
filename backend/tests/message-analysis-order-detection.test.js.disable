  test('TC-36 | Test updateOrderStatus method', async () => {
    // Given
    const orderId = 'invalid-order-id';
    const status = 'confirmed';
    const hostId = 'host123';
    const notes = 'Test notes';

    // When & Then - should throw error for invalid order
    await expect(
      orderDetectionService.updateOrderStatus(orderId, status, hostId, notes)
    ).rejects.toThrow();
  });

  test('TC-37 | Test error handling in analyzeMessage', async () => {
    // Given - message with invalid data that could cause errors
    const invalidMessages = [null, undefined, { content: null }, { content: undefined }];

    // When & Then - should handle errors gracefully
    for (const invalidMsg of invalidMessages.filter(Boolean)) {
      const result = await orderDetectionService.analyzeMessage(
        invalidMsg,
        makeStream(),
        makeUser()
      );
      expect(result).toBeNull();
    }
  });

  test('TC-38 | Test extractProductInfo error handling', async () => {
    // Given - message that might trigger errors in extractProductInfo
    const messageData = makeMessage('Chốt đơn size 42 0912345678');
    const streamData = makeStream({ featuredProducts: null }); // null featured products

    // When
    const result = await orderDetectionService.analyzeMessage(messageData, streamData, makeUser());

