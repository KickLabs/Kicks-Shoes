  test('TC-72 | Test shipping and payment keyword boosts', async () => {
    // Given - test ship/giao boost (+0.1) and COD/chuyển khoản boost (+0.2)
    const confShip = orderDetectionService.calculateConfidence(
      'ship hàng 0912345678',
