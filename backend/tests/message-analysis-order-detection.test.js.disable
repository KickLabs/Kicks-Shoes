      ['ship']
    );
    const confGiao = orderDetectionService.calculateConfidence(
      'giao hàng 0912345678',
      ['0912345678'],
      ['giao', 'giao hàng'] // Include high conf phrase
    );
    const confCOD = orderDetectionService.calculateConfidence(
      'COD chốt đơn 0912345678', // Add order keyword for boost
      ['0912345678'],
      ['cod', 'chốt', 'đơn']
    );
    const confChuyenKhoan = orderDetectionService.calculateConfidence(
      'chuyển khoản 0912345678',
      ['0912345678'],
      []
    );

    // Then - verify boosts are applied
    expect(confShip).toBeGreaterThan(0.3); // +0.1 for ship
    expect(confGiao).toBeGreaterThan(0.5); // High confidence phrase
    expect(confCOD).toBeGreaterThan(0.5); // +0.2 for COD + high conf phrase
    expect(confChuyenKhoan).toBeGreaterThan(0); // +0.2 for chuyển khoản
  });

