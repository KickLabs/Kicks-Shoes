  test('TC-88 | Test analyzeMessage with all result fields populated', async () => {
    // Given - comprehensive message (avoid composite pattern)
    const messageData = makeMessage('Mua ngay 0912345678');
    messageData._id = 'chat-msg-123';
    const streamData = makeStream({ _id: 'stream-456', roomId: 'room-789' });
    const userData = makeUser({
      _id: 'user-101',
      username: 'testbuyer',
      fullName: 'Test Buyer',
    });

    // When
    const result = await orderDetectionService.analyzeMessage(messageData, streamData, userData);

    // Then - verify all fields in result (lines 154-182)
    expect(result.isOrder).toBe(true);
    expect(result.confidence).toBeGreaterThan(0);
    expect(result.data.customerInfo.userId).toBe('user-101');
    expect(result.data.customerInfo.customerName).toBe('testbuyer');
    expect(result.data.customerInfo.phoneNumber).toBe('0912345678');
    expect(result.data.customerInfo.phoneNumbers).toEqual(['0912345678']);
    expect(result.data.productInfo.originalMessage).toBe(messageData.content);
    expect(result.data.productInfo.extractedQuantity).toBe(1); // Should be 1
    expect(result.data.productInfo.quantity).toBe(1); // Alias
    expect(result.data.detectionData.confidence).toBe(result.confidence);
    expect(result.data.detectionData.detectedKeywords.length).toBeGreaterThan(0);
    expect(result.data.detectionData.phoneMatches).toEqual(['0912345678']);
    expect(result.data.detectionData.timestamp).toBeInstanceOf(Date);
    expect(result.data.streamId).toBe('stream-456');
    expect(result.data.roomId).toBe('room-789');
    expect(result.data.chatMessageId).toBe('chat-msg-123');
  });

  test('TC-89 | Test confidence calculation with edge case combinations', async () => {
    // Given - test various combinations (pass empty arrays explicitly)
    const testCases = [
      {
        desc: 'No phone, no keywords',
        message: 'hello world',
        phones: [],
        keywords: [],
        expected: 0,
      },
      {
        desc: 'Phone array but no keywords',
        message: 'random text',
        phones: [], // Empty phones array
        keywords: [],
        expected: 0,
      },
      {
        desc: 'Keywords but no phone',
        message: 'talking about ordering',
        phones: [],
        keywords: [],
        expected: 0,
      },
      {
        desc: 'Both phone and keywords',
        message: 'chốt 0912345678',
        phones: ['0912345678'],
        keywords: ['chốt'],
        expectedMin: 0.3, // At least base confidence
      },
    ];

    for (const { message, phones, keywords, expected, expectedMin } of testCases) {
      const conf = orderDetectionService.calculateConfidence(message, phones, keywords);
      if (expected === 0) {
        expect(conf).toBe(0);
      } else if (expectedMin !== undefined) {
        expect(conf).toBeGreaterThanOrEqual(expectedMin);
      }
    }
  });

