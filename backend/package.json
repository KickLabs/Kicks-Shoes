{
  "name": "kicks-shoes-backend",
  "version": "1.0.0",
  "description": "Backend for Kicks Shoes E-commerce",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:all": "node run-all-tests.js",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:verbose": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/utils --coverage",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/integration --coverage",
    "test:services": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/services --coverage"
  },
  "dependencies": {
    "@google/genai": "^1.19.0",
    "@payos/node": "^2.0.3",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dompurify": "^3.2.7",
    "dotenv": "^16.4.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.2.3",
    "mongoose": "^8.1.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.0.7",
    "node-cron": "^4.1.0",
    "nodemailer": "^7.0.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "glob": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.4"
  }
}
