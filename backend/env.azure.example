# Azure App Service Environment Variables Template
# Copy this file and set your actual values in Azure Portal > App Services > Configuration

# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kicks-shoes

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ===========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ===========================================

# VNPay Payment Gateway
VNPAY_TMN_CODE=your-vnpay-tmn-code
VNPAY_HASH_SECRET=your-vnpay-hash-secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-app.azurewebsites.net/api/payment/vnpay/return

# Google AI Integration
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Azure App Service Specific
NODE_ENV=production
PORT=8080
WEBSITE_NODE_DEFAULT_VERSION=18-lts

# ===========================================
# AZURE DEPLOYMENT NOTES
# ===========================================

# 1. Set these variables in Azure Portal:
#    - Go to Azure Portal > App Services > your-app-name > Configuration
#    - Click "New application setting" for each variable
#    - Make sure to mark sensitive values as "Slot setting" if needed

# 2. For MongoDB Atlas:
#    - Make sure your IP is whitelisted or use 0.0.0.0/0 for Azure IPs
#    - Use connection string format: mongodb+srv://user:pass@cluster.mongodb.net/dbname

# 3. For Cloudinary:
#    - Sign up at cloudinary.com
#    - Get your credentials from the dashboard

# 4. For Email:
#    - Use Gmail with App Passwords (not your regular password)
#    - Enable 2FA and generate an App Password

# 5. For VNPay:
#    - Register at vnpayment.vn
#    - Get your TMN code and hash secret
#    - Update return URL to your Azure domain

# 6. For Google AI:
#    - Get API key from Google AI Studio
#    - Enable the Generative AI API











