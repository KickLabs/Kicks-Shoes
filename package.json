{
  "name": "kicks-shoes",
  "version": "1.0.0",
  "description": "Kicks Shoes E-commerce Project",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "security:scan": "node scripts/security/pre-push-audit.cjs",
    "lint:changed": "node scripts/security/lint-changed.cjs",
    "prepush:verify": "npm run security:scan && npm run lint:changed && npm test",
    "prepush:verify:full": "npm run security:scan && npm run lint && npm test",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@babel/eslint-parser": "^7.28.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/charts": "^2.3.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.80.6",
    "@tinymce/tinymce-react": "^6.3.0",
    "antd": "^5.26.3",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "react-chartjs-2": "^5.3.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.57.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.57"
  }
}
